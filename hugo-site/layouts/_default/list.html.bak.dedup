{{ define "main" }}

<section class="archive">
  {{- /* 优先取 phaseLabel（火·AI / 金·判断 等），fallback 到 title */ -}}
  <h1 class="article-title">{{ .Params.phaseLabel | default .Title | default "Posts" }}</h1>
  {{- with .Description }}
  <p class="section-subtitle">{{ . }}</p>
  {{- end }}
  <ul class="post-archive">
    {{- /* 候选集：posts + series 子页（系列本体文章）*/ -}}
    {{- $all := where .Site.RegularPages "Section" "in" (slice "posts" "series") }}
    {{- if eq .Section "series" }}
      {{- with .File }}
        {{- $slug := .ContentBaseName }}
        {{- /* 取属于此系列的：posts 下声明 series 包含 slug 的，加上 series/<slug>/ 自己目录里的所有子页 */ -}}
        {{- $bySeriesParam := where $all "Params.series" "intersect" (slice $slug) }}
        {{- $bySection := where (where $all "Section" "series") "File.Dir" "intersect" (slice (printf "series/%s/" $slug)) }}
        {{- $all = $bySeriesParam | union $bySection }}
      {{- end }}
    {{- end }}
    {{- $filtered := slice }}
    {{- range $all }}
      {{- if ne (partial "has_tag.html" (dict "page" . "tag" "draft")) "true" }}
        {{- $filtered = $filtered | append . }}
      {{- end }}
    {{- end }}
    {{- $filtered = sort $filtered "Date" "desc" }}
    {{- $p := .Paginate $filtered }}
    {{- range $p.Pages }}
    <li class="post-item">
      <a class="post-title" href="{{ .RelPermalink }}">{{ .Title }}</a>
      <time class="post-date">{{ .Date.Format "2006-01-02" }}</time>
    </li>
    {{- end }}
  </ul>
  {{ partial "paginator.html" $p }}
</section>

{{ partial "footer.html" . }}
{{ end }}
