{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
  {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- $tags := delimit (.Params.tags | default slice) " " -}}
    {{- $categories := delimit (.Params.categories | default slice) " " -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "content" .Plain "permalink" .Permalink "summary" .Summary "description" .Description "tags" $tags "categories" $categories) -}}
  {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
