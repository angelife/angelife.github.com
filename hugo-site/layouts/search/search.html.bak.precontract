<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">

  {{- $separator := printf " %s " (.Site.Params.separator | default "-") -}}
  {{- $title := .Site.Title -}}
  {{- if and .IsHome (.Site.Params.subtitle) -}}
    {{- $title = printf "%s%s%s" $title $separator .Site.Params.subtitle -}}
  {{- end -}}
  {{- if and (not .IsHome) .Title -}}
    {{- $title = printf "%s%s%s" .Title $separator .Site.Title -}}
  {{- end -}}

  <title>{{ $title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script>
    (() => {
      const storageKey = 'theme';
      let saved = null;
      try { saved = localStorage.getItem(storageKey); } catch {}
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'system') {
        try { localStorage.removeItem(storageKey); } catch {}
        saved = null;
      }
      if (saved !== 'dark' && saved !== 'light') saved = null;
      const theme = saved ? saved : prefersDark ? 'dark' : 'light';
      document.documentElement.dataset.themePref = saved ? theme : 'system';
      document.documentElement.dataset.theme = theme;
    })();
  </script>

  {{- with .Site.Params.description -}}
  <meta name="description" content="{{ . }}">
  {{- end -}}
  {{- with .Site.Params.favicon -}}
  <link rel="shortcut icon" type="image/x-icon" href="{{ . }}">
  {{- end -}}
  <link rel="stylesheet" href="/css/style.css?v={{ now.Unix }}">
</head>

  <body id="top">
    <div class="container">
      <header class="header">
  <div class="blog-title">
    <a href="/" class="logo">{{ .Site.Title }}</a>
    <div class="subtitle">{{ .Site.Params.subtitle | default "" }}</div>
  </div>
  <nav class="navbar" aria-label="主导航">
    <ul class="menu">
      {{- range .Site.Menus.main -}}
        <li class="menu-item">
          <a href="{{ .URL }}" class="menu-item-link">{{ .Name }}</a>
        </li>
      {{- end }}
    </ul>
  </nav>
</header>

      <section class="search-page">
        <h1 class="article-title">{{ .Title }}</h1>
        <div class="search-box">
          <input id="search-input" type="text" placeholder="搜索..." />
          <div id="results"></div>
        </div>
      </section>
      <script src="/js/search.js"></script>

      <footer>
  © 2009–2026
  <span class="author">angelife / 安知生</span>
</footer>

    </div>
    <script src="/js/main.js" defer></script>
  </body>
</html>
